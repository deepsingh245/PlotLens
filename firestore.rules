rules_version = '2';

// See docs/SECURITY.md §Firebase security rules and docs/DATA_MODEL.md.
// Deny-by-default. Owner-only. No `allow read, write: if true` anywhere.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    match /projects/{projectId} {
      allow read: if isOwner(resource.data.ownerId);

      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.keys().hasAll(
             ['ownerId', 'name', 'map', 'layers', 'overlays', 'annotations', 'savedViews', 'createdAt', 'updatedAt']
           )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.map.zoom >= 0 && request.resource.data.map.zoom <= 22
        // Phase 1: these entities don't exist yet — reject any attempt to seed them on create.
        && request.resource.data.layers.size() == 0
        && request.resource.data.overlays.size() == 0
        && request.resource.data.annotations.size() == 0
        && request.resource.data.savedViews.size() == 0;

      allow update: if isOwner(resource.data.ownerId)
        // ownerId is immutable — never trust a client-supplied ownership change.
        && request.resource.data.ownerId == resource.data.ownerId
        && (!('map' in request.resource.data)
            || (request.resource.data.map.zoom >= 0 && request.resource.data.map.zoom <= 22));

      allow delete: if isOwner(resource.data.ownerId);
    }

    // Deny-by-default catch-all — anything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
