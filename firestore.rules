rules_version = '2';

// See docs/SECURITY.md §Firebase security rules and docs/DATA_MODEL.md.
// Deny-by-default. Owner-only. No `allow read, write: if true` anywhere.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // A subcollection entity is only accessible if its parent project belongs to the
    // requester (docs/SECURITY.md §Firebase security rules) — costs one extra read per
    // request but is the standard Firestore pattern for parent-scoped ownership.
    function isProjectOwner(projectId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if isOwner(resource.data.ownerId);

      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.keys().hasAll(
             ['ownerId', 'name', 'map', 'layers', 'overlays', 'annotations', 'savedViews', 'createdAt', 'updatedAt']
           )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.map.zoom >= 0 && request.resource.data.map.zoom <= 22
        // Phase 1: these entities don't exist yet — reject any attempt to seed them on create.
        && request.resource.data.layers.size() == 0
        && request.resource.data.overlays.size() == 0
        && request.resource.data.annotations.size() == 0
        && request.resource.data.savedViews.size() == 0;

      allow update: if isOwner(resource.data.ownerId)
        // ownerId is immutable — never trust a client-supplied ownership change.
        && request.resource.data.ownerId == resource.data.ownerId
        && (!('map' in request.resource.data)
            || (request.resource.data.map.zoom >= 0 && request.resource.data.map.zoom <= 22));

      allow delete: if isOwner(resource.data.ownerId);

      // Geometry/content validation happens client-side (src/gis/annotationGeometry.ts) —
      // see docs/DATA_MODEL.md. Rules enforce ownership and the projectId tie-back only.
      match /annotations/{annotationId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && request.resource.data.projectId == projectId;
        allow update: if isProjectOwner(projectId)
          && request.resource.data.projectId == resource.data.projectId;
        allow delete: if isProjectOwner(projectId);
      }

      // Corner geometry validation is client-side (src/gis/imageOverlayGeometry.ts) —
      // rules only do a coarse shape/bounds backstop, docs/plans/plan-3.md Task 6.
      match /overlays/{overlayId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.coordinates.size() == 4
          && request.resource.data.opacity >= 0 && request.resource.data.opacity <= 1;
        allow update: if isProjectOwner(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && (!('coordinates' in request.resource.data) || request.resource.data.coordinates.size() == 4)
          && (!('opacity' in request.resource.data)
              || (request.resource.data.opacity >= 0 && request.resource.data.opacity <= 1));
        allow delete: if isProjectOwner(projectId);
      }

      match /savedViews/{savedViewId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && request.resource.data.projectId == projectId;
        allow delete: if isProjectOwner(projectId);
        // No update rule — SavedView is create/delete only (no updateSavedView exists in the app).
      }

      // Append-only — no update/delete rule (docs/PROJECT_SPEC.md §25: "simple event
      // logging, not a full audit system"). The app never calls those operations.
      match /investigationEvents/{eventId} {
        allow read: if isProjectOwner(projectId);
        allow create: if isProjectOwner(projectId) && request.resource.data.projectId == projectId;
      }
    }

    // Deny-by-default catch-all — anything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
