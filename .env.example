# PlotLens environment variables — TEMPLATE ONLY.
# Copy to .env.local and fill in real values there. Never commit .env.local or real secrets.
# See docs/SECURITY.md §"API Key Security" before adding any new key here.

# --- Map engine / base map ---
# Which base map provider to use behind MapLibre GL JS. See docs/ADR/0001-map-engine.md.
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAP_STYLE_URL=

# Only if a commercial/token-based tile provider is configured (e.g. Mapbox). Public/browser-exposed
# tokens must be domain-restricted at the provider — see docs/DATA_SOURCES.md before enabling.
NEXT_PUBLIC_MAP_TOKEN=

# --- Mappls (India-specific commercial provider) — only if adopted, see docs/DATA_SOURCES.md ---
NEXT_PUBLIC_MAPPLS_KEY=

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firestore/Auth emulators (firebase.json)
# instead of the real project — see "npm run emulators". Leave unset/false otherwise.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# Server-only. Never prefix with NEXT_PUBLIC_. Never commit real values.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- AI provider (Phase 9 — not used until natural-language features are built) ---
AI_PROVIDER=
AI_API_KEY=
